{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schema metadata_tematico para CONTRIBUICOES_PREVIDENCIARIAS.REMUNERACAO",
  "description": "Aplicado quando ato_materia.tema_especifico = 'CONTRIBUICOES_PREVIDENCIARIAS.REMUNERACAO'. Captura a natureza (remuneratória vs indenizatória) das verbas pagas a empregados/segurados.",
  "type": "object",
  "required": ["verba_em_analise", "natureza_definida"],
  "properties": {
    "verba_em_analise": {
      "type": "string",
      "description": "Nome da verba em discussão",
      "examples": ["aviso prévio indenizado", "1/3 constitucional de férias", "auxílio-alimentação", "PLR", "stock options"]
    },
    "natureza_pretendida_contribuinte": {
      "type": ["string", "null"],
      "enum": ["indenizatoria", "remuneratoria", "ambigua", null]
    },
    "natureza_pretendida_fazenda": {
      "type": ["string", "null"],
      "enum": ["indenizatoria", "remuneratoria", "ambigua", null]
    },
    "natureza_definida": {
      "type": "string",
      "enum": ["indenizatoria_nao_incide", "remuneratoria_incide", "habitualidade_incide", "habitualidade_nao_incide", "diligencia"]
    },
    "incide_contribuicao": {
      "type": "object",
      "properties": {
        "patronal": { "type": "boolean" },
        "segurado": { "type": "boolean" },
        "rat_gilrat": { "type": "boolean" },
        "terceiros_sistema_s": { "type": "boolean" }
      }
    },
    "tema_stf_stj_invocado": {
      "type": "array",
      "items": { "type": "string" },
      "examples": [["Tema 985 STF (terço de férias)", "Tema 163 STF (PLR)"]]
    },
    "habitualidade_caracterizada": {
      "type": ["boolean", "null"],
      "description": "Se houve análise de habitualidade do pagamento"
    },
    "lei_8212_91_dispositivo": {
      "type": ["string", "null"],
      "description": "Dispositivo da Lei 8.212/91 invocado",
      "examples": ["art. 28, § 9º, alínea 'e'"]
    }
  },
  "additionalProperties": false
}
