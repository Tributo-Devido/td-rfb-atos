# Postgres LOCAL (Docker compose porta 5435)
PG_DSN=postgresql://td:<<PG_PASSWORD>>@localhost:5435/td_rfb_atos

# Postgres LEGADO (banco tais do tdax) — apenas para migração inicial dos dados existentes
PG_DSN_LEGACY=postgresql://<usuario>:<senha>@<host-legado>:5432/tais

# Anthropic — categorização via Haiku 4.5
ANTHROPIC_API_KEY=sk-ant-...

# Google — embeddings via Gemini text-embedding-004 (1024-dim, mesma família do td-carf)
GOOGLE_API_KEY=AIza...

# Diretórios de trabalho
PDF_DIR=./pdfs
LOG_DIR=./logs

# Limites
LLM_MAX_CONCURRENT=3
EMBED_MAX_CONCURRENT=5
